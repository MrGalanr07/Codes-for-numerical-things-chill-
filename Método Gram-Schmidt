% Datos de entrada como celda de vectores

V = { [1; -1; 1], [1; 0; 1], [1; 1; 2] };   % podemos agregar o quitar vectores libremente
n = length(V);       % número de vectores 

M = [V{1,1}, V{1,2}, V{1,3}];


% Con esto verificamos que los vectores son LI. Si el rang(M) es menor que el número de vectores, entonces no son LI

if rank(M) < n

    error('Los vectores no son LI (rank(A) = %d < %d).', rank(m), n); 

end

ORT = cell(1, n);      % aquí guardaremos los vectores ortonormales

e_1 = V{1, 1}/norm(V{1, 1});

ORT{1, 1} = e_1;

for j = 2:n
    v = V{j};                     % vector j-ésimo, se va "limpiando" de la celda

    % Debemos restar j-1 veces 

    for i = 1:j-1

        proj = dot(ORT{i}, v);        % coeficiente de proyección sobre e_i
        v = v - proj * ORT{i};        % se resta esa componente

    end

    normav = norm(v);
    
    ORT{j} = v / normav;            % vector j-ésimo ya ortonormal, u en la fórmula

end

% Resultado

disp('Vectores ortonormales obtenidos:');

for j = 1:n

    fprintf('e_%d = ', j); disp(ORT{j}')

end

